{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "love-travel-client-v2-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "LOVE_TRAVEL_UPSTREAM": "https://lovetravel.viiversion.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
