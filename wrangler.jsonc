{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "love-travel-demo",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-08",
  "vars": {
    "TELEGRAM_MINIAPP_URL": "https://lovetravel.viiversion.com",
    "AUTH_MODE": "demo"
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "love-travel-demo",
      "database_id": "082e0c3d-056c-445a-b09d-d91dc05d2b98"
    }
  ],
  "routes": [
    {
      "pattern": "lovetravel.viiversion.com",
      "custom_domain": true
    }
  ]
}
