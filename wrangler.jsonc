{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "love-travel-v28",
  "main": "./src/worker-r2.js",
  "compatibility_date": "2026-09-09",
  "vars": {
    "APP_ENV": "love-travel-v28",
    "APP_URL": "https://lovetravel.viiversion.com",
    "PUBLIC_ADMIN_DEMO": "true",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "USD_RUB_RATE": "84.2569"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "love-travel-v28-db",
      "database_id": "db0ac2cd-d809-4221-a333-fc2b1a09406e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TOUR_MEDIA",
      "bucket_name": "love-travel-v28-media",
      "preview_bucket_name": "love-travel-v28-media"
    }
  ]
}
