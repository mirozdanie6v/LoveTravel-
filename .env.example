# Optional real Telegram Bot integration.
# Keep these server-side only; never expose them to the Vite client bundle.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# Back-office authorization mode.
# Keep demo for the public proposal/demo. Switch to telegram only after the Bot Token
# and first owner bootstrap ID are configured.
AUTH_MODE=demo

# Safe first-owner bootstrap for production Telegram RBAC.
# When AUTH_MODE=telegram, the first correctly signed Telegram user whose ID matches
# BOOTSTRAP_OWNER_TELEGRAM_ID becomes Owner if staff_accounts is still empty.
# After that, Owner manages Manager/Admin/Owner accounts from the application.
BOOTSTRAP_OWNER_TELEGRAM_ID=
BOOTSTRAP_OWNER_NAME=

# Optional Tilda form webhook guard. Put the same value in the webhook URL query parameter.
TILDA_WEBHOOK_SECRET=

# Public, non-secret value. Production default is also set in wrangler.jsonc.
TELEGRAM_MINIAPP_URL=https://max-tour.viiversion.com

# GitHub Actions deployment uses repository secrets with these names:
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
