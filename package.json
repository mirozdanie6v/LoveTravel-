{
  "name": "love-travel-v28-standalone",
  "version": "28.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-tour-media.mjs && node build.mjs",
    "prepare:tour-media": "node scripts/prepare-tour-media.mjs",
    "verify:tour-media": "node scripts/verify-live-tour-media.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test:client-v2:e2e": "playwright test --config=playwright.config.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0",
    "@playwright/test": "^1.55.0"
  }
}
