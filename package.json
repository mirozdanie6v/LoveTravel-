{
  "name": "max-tour-telegram-miniapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply max-tour-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply max-tour-demo --remote",
    "db:seed:local": "wrangler d1 execute max-tour-demo --local --file=seed/verified-max-tour-data.sql",
    "db:seed:remote": "wrangler d1 execute max-tour-demo --remote --file=seed/verified-max-tour-data.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
